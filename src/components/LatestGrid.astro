---
import { getLatestPosts, type LatestPost } from '@/lib/sanity';
import { getInstagramPosts, type BeholdPost } from '@/lib/instagram';
import { useTranslations, type Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

interface DisplayItem {
  id: string;
  caption: string;
  imageUrl: string | null;
  link: string | null;
  date: string | null;
}

// Priority: Sanity (NGO-curated) → Behold (auto Instagram) → static i18n fallback
// Fetch all available posts. Behold's free tier returns up to ~25;
// Sanity has no cap. The horizontal-scroll layout below scales to any N.
const sanityPosts = await getLatestPosts(50);

let items: DisplayItem[];
let source: 'sanity' | 'behold' | 'fallback';

if (sanityPosts && sanityPosts.length > 0) {
  source = 'sanity';
  items = sanityPosts.map((p: LatestPost) => ({
    id: p._id,
    caption: p.caption,
    imageUrl: p.image?.asset?.url ?? null,
    link: p.instagramUrl ?? null,
    date: p.publishedAt,
  }));
} else {
  const beholdPosts = await getInstagramPosts(50);
  if (beholdPosts && beholdPosts.length > 0) {
    source = 'behold';
    items = beholdPosts.map((p: BeholdPost) => ({
      id: p.id,
      caption: p.prunedCaption || p.caption,
      imageUrl: p.sizes?.medium?.mediaUrl ?? p.thumbnailUrl ?? p.mediaUrl,
      link: p.permalink,
      date: p.timestamp,
    }));
  } else {
    source = 'fallback';
    items = t.latest.fallback.map((f, i) => ({
      id: `fallback-${i}`,
      caption: f.caption,
      imageUrl: null,
      link: f.link || null,
      date: null,
    }));
  }
}

const dateFmt = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'short', day: 'numeric' });
---

<section class="bg-gray-900 py-20" data-source={source}>
  <div class="container mx-auto px-4">
    <div class="mb-8 flex items-baseline justify-between gap-4">
      <div>
        <h2 class="text-4xl font-bold text-white">{t.latest.title}</h2>
        <p class="mt-2 text-sm text-gray-400">From @theplayablenetwork</p>
      </div>
      {/* Desktop prev/next scroll controls */}
      <div class="hidden shrink-0 items-center gap-2 md:flex">
        <button
          type="button"
          data-scroll-prev
          aria-label="Scroll to previous posts"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white transition hover:bg-white/15 disabled:cursor-not-allowed disabled:opacity-30 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>
        <button
          type="button"
          data-scroll-next
          aria-label="Scroll to next posts"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white transition hover:bg-white/15 disabled:cursor-not-allowed disabled:opacity-30 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </button>
      </div>
    </div>

    {/* Horizontal-scroll row of post cards. Native browser scroll +
        snap-x mandatory for smooth "always land on a card" behavior.
        Peek-margin (-mx-4/px-4) lets adjacent card edges hint at scroll. */}
    <div
      id="latest-scroll"
      class="latest-scroll -mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-4 pb-4 md:gap-6"
      role="region"
      aria-label={t.latest.title}
      tabindex="0"
    >
      {
        items.map((item) => (
          <article class="group flex snap-start shrink-0 w-[80%] max-w-[320px] flex-col overflow-hidden rounded-2xl bg-gray-800 shadow-lg md:w-72 lg:w-80">
            {/* Square photo */}
            <div class="relative aspect-square overflow-hidden bg-gradient-to-br from-brand to-brand-accent">
              {item.imageUrl ? (
                <img
                  src={item.imageUrl}
                  alt=""
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-brand-light to-brand-cyan">
                  <svg class="h-12 w-12 text-white/40" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-5.04-6.71l-2.75 3.54h2.86l2.43-3.24 1.5 2h2.92L16.96 9.5z"/>
                  </svg>
                </div>
              )}
            </div>

            {/* Caption + date + link — always visible, below the photo */}
            <div class="flex flex-1 flex-col p-4 text-white">
              {item.date && (
                <p class="text-xs font-semibold uppercase tracking-widest text-brand-gold">
                  {dateFmt.format(new Date(item.date))}
                </p>
              )}
              <p class="mt-2 flex-1 text-sm leading-snug text-gray-100 line-clamp-3">{item.caption}</p>
              {item.link && (
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-brand-accent transition hover:text-brand-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent focus-visible:ring-offset-2 focus-visible:ring-offset-gray-800 rounded-sm"
                >
                  View post
                  <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6v12h12v-6m0-6l-7 7"/>
                  </svg>
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Hide the horizontal scrollbar visually — prev/next buttons on desktop
     and touch on mobile provide the affordance. Keeps the design clean. */
  .latest-scroll {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .latest-scroll::-webkit-scrollbar {
    display: none;
  }
</style>

<script is:inline>
  (function () {
    const scroll = document.getElementById('latest-scroll');
    const prev = document.querySelector('[data-scroll-prev]');
    const next = document.querySelector('[data-scroll-next]');
    if (!scroll || !prev || !next) return;

    // Scroll by ~70% of visible width per click (one to three cards depending on breakpoint)
    const step = () => Math.max(280, Math.round(scroll.clientWidth * 0.7));

    prev.addEventListener('click', () => scroll.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => scroll.scrollBy({ left: step(), behavior: 'smooth' }));

    // Disable prev at the start and next at the end so buttons reflect state
    const updateBounds = () => {
      const atStart = scroll.scrollLeft <= 4;
      const atEnd = scroll.scrollLeft + scroll.clientWidth >= scroll.scrollWidth - 4;
      prev.disabled = atStart;
      next.disabled = atEnd;
    };
    scroll.addEventListener('scroll', updateBounds, { passive: true });
    window.addEventListener('resize', updateBounds);
    // Run once on load so the "at start" state is correct
    updateBounds();
  })();
</script>
